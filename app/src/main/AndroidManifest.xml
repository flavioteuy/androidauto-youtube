<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Audio al manejar: servicio de reproducción en primer plano con su notificación. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Opcional: el GPS permite tapar la imagen si el vehículo se mueve
         (protección extra; Android Auto ya bloquea las apps "para estacionado" al manejar). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      App "para usar estacionado" (parked app) de Android Auto.
      Android Auto solo acepta esta categoría para juegos, por eso appCategory="game".
      A diferencia de las apps de plantillas, a estas SÍ se les aplica la opción
      "Fuentes desconocidas" de los ajustes para desarrolladores de Android Auto.
    -->
    <application
        android:allowBackup="false"
        android:appCategory="game"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutoVideo">

        <!-- App del teléfono: enviar videos al auto, permisos e instrucciones -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Compartir" desde la app de YouTube -> AutoVideo -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Pantalla del auto: la abre Android Auto desde su menú de apps -->
        <activity
            android:name=".car.CarPlayerActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:taskAffinity="uy.autovideo.car"
            android:theme="@style/Theme.AutoVideo.Car"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.CAR_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Mantiene viva la app mientras suena, para que el audio siga cuando Android Auto oculta el
             video al manejar. No es un servicio de música para Android Auto (no lo registra como tal). -->
        <service
            android:name=".car.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Sin servicio de música ni declaración "media": con eso Android Auto abría una pantalla
             de música vacía en vez del video. La sesión de reproducción queda dentro de la app. -->

    </application>
</manifest>

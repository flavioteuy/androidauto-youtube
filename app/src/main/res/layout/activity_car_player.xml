<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/car_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:fitsSystemWindows="true">

    <!-- YouTube ocupa toda la pantalla -->
    <uy.autovideo.car.BackgroundWebView
        android:id="@+id/car_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Botones flotantes semitransparentes (arriba a la izquierda) -->
    <LinearLayout
        android:id="@+id/car_pill"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">

        <ImageButton
            android:id="@+id/car_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/car_back"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_back" />

        <ImageButton
            android:id="@+id/car_home"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/car_home"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/car_search_go"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/car_search"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_search" />
    </LinearLayout>

    <!-- Buscador: aparece al tocar la lupa y se oculta al buscar -->
    <AutoCompleteTextView
        android:id="@+id/car_search"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_gravity="top"
        android:layout_marginStart="136dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/search_bg"
        android:completionThreshold="1"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#FFFFFFFF"
        android:textColorHint="#B3FFFFFF"
        android:textSize="17sp"
        android:visibility="gone" />

    <!-- Aviso que tapa la imagen si el vehículo se mueve (el audio sigue) -->
    <TextView
        android:id="@+id/car_lock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FF000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:padding="32dp"
        android:text="@string/lock_moving"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:visibility="gone" />

</FrameLayout>

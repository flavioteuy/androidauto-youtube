<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            style="@style/BodyText"
            android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <!-- Enviar un video al auto -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/CardTitle"
                android:text="@string/send_title" />

            <EditText
                android:id="@+id/input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/send_hint"
                android:imeOptions="actionSend"
                android:importantForAutofill="no"
                android:inputType="text"
                android:minHeight="48dp"
                android:textColor="@color/text" />

            <Button
                android:id="@+id/send_button"
                style="@style/AccentButton"
                android:text="@string/send_button" />

            <TextView
                android:id="@+id/send_status"
                style="@style/BodyText"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <TextView
                style="@style/BodyText"
                android:text="@string/share_tip" />
        </LinearLayout>

        <!-- Permiso -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/CardTitle"
                android:text="@string/perm_title" />

            <TextView
                android:id="@+id/perm_status"
                style="@style/BodyText" />

            <Button
                android:id="@+id/perm_button"
                style="@style/AccentButton"
                android:text="@string/perm_button" />

            <!-- Ajustes: velocidad mínima y segundos de movimiento sostenido -->
            <TextView
                style="@style/BodyText"
                android:layout_marginTop="12dp"
                android:text="@string/motion_desc" />

            <TextView
                android:id="@+id/motion_speed_label"
                style="@style/BodyText"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/motion_speed"
                android:layout_width="match_parent"
                android:layout_height="40dp" />

            <TextView
                android:id="@+id/motion_seconds_label"
                style="@style/BodyText"
                android:textColor="@color/text"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/motion_seconds"
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Tablero del auto: lo que suena y botones del volante -->
        <LinearLayout style="@style/CardBox">

            <Switch
                android:id="@+id/dashboard_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/dashboard_title"
                android:textColor="@color/text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/BodyText"
                android:text="@string/dashboard_desc" />
        </LinearLayout>

        <!-- Probar la pantalla del auto en el teléfono y copiar el diagnóstico -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/CardTitle"
                android:text="@string/diag_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/diag_desc" />

            <Button
                android:id="@+id/phone_preview_button"
                style="@style/AccentButton"
                android:text="@string/preview_button" />

            <Button
                android:id="@+id/diag_copy_button"
                style="@style/AccentButton"
                android:text="@string/diag_copy_button" />

            <TextView
                android:id="@+id/diag_status"
                style="@style/BodyText" />
        </LinearLayout>

        <!-- Instrucciones -->
        <LinearLayout style="@style/CardBox">

            <TextView
                style="@style/CardTitle"
                android:text="@string/setup_title" />

            <TextView
                style="@style/BodyText"
                android:text="@string/setup_steps" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
